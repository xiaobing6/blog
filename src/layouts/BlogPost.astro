---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import PostNavigation from '../components/PostNavigation.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { PROFILE } from '../data/profile';
import type { AdjacentPosts, BlogPost, ReadingStats } from '../utils/posts';
import PageLayout from './PageLayout.astro';

interface Props {
	post: BlogPost;
	headings: MarkdownHeading[];
	stats: ReadingStats;
	adjacent: AdjacentPosts;
	related: BlogPost[];
}

const { post, headings, stats, adjacent, related } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, category, draft } = post.data;
const heroImagePath = typeof heroImage === 'string' ? heroImage : heroImage?.src;
const site = Astro.site ?? new URL('https://xiaobing6-blog.pages.dev');
const postUrl = new URL('/blog/' + post.id + '/', site).href;
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	mainEntityOfPage: postUrl,
	url: postUrl,
	inLanguage: 'zh-CN',
	wordCount: stats.words,
	keywords: tags.join(', '),
	articleSection: category,
	author: {
		'@type': 'Person',
		name: PROFILE.name,
		url: site.href,
	},
	...(heroImagePath ? { image: new URL(heroImagePath, site).href } : {}),
};
const hasToc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length > 1;
---

<PageLayout
	title={title}
	description={description}
	image={heroImage}
	pageType="article"
	publishedTime={pubDate}
	updatedTime={updatedDate}
	tags={tags}
	noindex={draft}
	structuredData={structuredData}
	wide
	mainClass="article-page"
>
	<article data-pagefind-body>
		<header class="article-header">
			<div class="article-kicker">
				<a href={'/blog/categories/' + encodeURIComponent(category) + '/'}>{category}</a>
				<span aria-hidden="true">/</span>
				<span>ARTICLE</span>
				{draft && <span class="draft-badge">草稿预览</span>}
			</div>
			<h1 data-pagefind-meta="title">{title}</h1>
			<p class="description" data-pagefind-meta="description">{description}</p>
			<div class="article-meta">
				<span>发布于 <FormattedDate date={pubDate} /></span>
				{
					updatedDate && (
						<span>
							更新于 <FormattedDate date={updatedDate} />
						</span>
					)
				}
				<span>{stats.minutes} 分钟阅读</span>
				<span>约 {stats.words} 字</span>
			</div>
			{
				tags.length > 0 && (
					<ul class="tag-list" aria-label="文章标签">
						{tags.map((tag) => (
							<li>
								<a class="tag" href={'/blog/tags/' + encodeURIComponent(tag) + '/'}>
									#{tag}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</header>

		{
			heroImage && (
				<div class="hero-image" data-pagefind-meta="image[src]">
					{typeof heroImage === 'string' ? (
						<img
							src={heroImage}
							alt=""
							width="1200"
							height="600"
							loading="eager"
							fetchpriority="high"
						/>
					) : (
						<Image
							src={heroImage}
							alt=""
							width={1200}
							height={600}
							loading="eager"
							fetchpriority="high"
						/>
					)}
				</div>
			)
		}

		<div class:list={['article-grid', { 'article-grid--single': !hasToc }]}>
			{
				hasToc && (
					<aside class="toc-column">
						<TableOfContents headings={headings} />
					</aside>
				)
			}
			<div class="article-content">
				<div class="prose">
					<slot />
				</div>
				<PostNavigation adjacent={adjacent} />
				<RelatedPosts posts={related} />
			</div>
		</div>
	</article>
</PageLayout>

<script>
	const copyButtons = document.querySelectorAll<HTMLButtonElement>('.copy-code');

	if (copyButtons.length === 0) {
		document.querySelectorAll<HTMLElement>('.prose pre').forEach((block) => {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'copy-code';
			button.textContent = '复制';
			button.setAttribute('aria-label', '复制代码');
			button.addEventListener('click', async () => {
				const code = block.querySelector('code')?.textContent ?? '';
				try {
					await navigator.clipboard.writeText(code);
					button.textContent = '已复制';
					window.setTimeout(() => {
						button.textContent = '复制';
					}, 1600);
				} catch {
					button.textContent = '复制失败';
				}
			});
			block.appendChild(button);
		});
	}

	const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]'));
	const headingMap = new Map(
		tocLinks
			.map((link) => {
				const id = decodeURIComponent(link.hash.slice(1));
				const heading = document.getElementById(id);
				return heading ? ([heading, link] as const) : null;
			})
			.filter((item): item is readonly [HTMLElement, HTMLAnchorElement] => item !== null),
	);

	if (headingMap.size > 0 && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				const active = entries
					.filter((entry) => entry.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
				if (!active) return;
				tocLinks.forEach((link) => link.removeAttribute('aria-current'));
				headingMap.get(active.target as HTMLElement)?.setAttribute('aria-current', 'true');
			},
			{ rootMargin: '-18% 0px -70% 0px' },
		);
		headingMap.forEach((_link, heading) => observer.observe(heading));
	}
</script>

<style>
	.article-header {
		max-width: 860px;
		margin: 0 auto 2.5rem;
		text-align: center;
	}

	.article-kicker {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 1rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
	}

	.article-kicker a {
		color: var(--accent);
	}

	.draft-badge {
		padding: 0.12rem 0.5rem;
		border-radius: 999px;
		background: var(--accent-surface);
		color: var(--accent);
	}

	.article-header h1 {
		margin-bottom: 1.2rem;
		font-size: clamp(2.25rem, 7vw, 4.3rem);
	}

	.description {
		max-width: 680px;
		margin: 0 auto 1.2rem;
		color: var(--text-secondary);
		font-size: 1.08rem;
	}

	.article-meta {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		margin-bottom: 1rem;
		color: var(--text-muted);
		font-size: 0.76rem;
	}

	.article-header .tag-list {
		justify-content: center;
	}

	.hero-image {
		max-width: 1040px;
		margin: 0 auto 3rem;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--bg-secondary);
	}

	.hero-image :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
	}

	.article-grid {
		display: grid;
		grid-template-columns: 210px minmax(0, 760px);
		justify-content: center;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.article-grid--single {
		grid-template-columns: minmax(0, 760px);
	}

	.article-content {
		min-width: 0;
	}

	:global(.copy-code) {
		position: absolute;
		top: 0.65rem;
		right: 0.65rem;
		z-index: 1;
		min-width: 56px;
		min-height: 34px;
		padding: 0.3rem 0.65rem;
		border: 1px solid var(--background-700);
		border-radius: 8px;
		background: color-mix(in srgb, var(--code-bg) 84%, white);
		color: var(--code-text);
		cursor: pointer;
		font-size: 0.72rem;
	}

	:global(.copy-code:hover) {
		border-color: var(--text-300);
	}

	@media (max-width: 940px) {
		.article-grid {
			grid-template-columns: minmax(0, 760px);
		}

		.toc-column {
			display: none;
		}
	}

	@media (max-width: 720px) {
		.article-header {
			text-align: left;
		}

		.article-kicker,
		.article-meta,
		.article-header .tag-list {
			justify-content: flex-start;
		}

		.hero-image {
			margin-bottom: 2rem;
			border-radius: var(--radius-md);
		}
	}
</style>
