---
import { PROFILE } from '../data/profile';

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<ul class:list={['social-links', { compact }]} aria-label="站外链接">
	{
		PROFILE.socialLinks.map((link) => (
			<li>
				<a
					href={link.href}
					target={link.external ? '_blank' : undefined}
					rel={link.external ? 'noreferrer' : undefined}
				>
					{link.label}
					{link.external && <span aria-hidden="true">↗</span>}
				</a>
			</li>
		))
	}
</ul>

<style>
	.social-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		min-height: 44px;
		color: var(--text-secondary);
		font-size: 0.9rem;
		font-weight: 550;
	}

	a:hover {
		color: var(--accent);
	}

	.compact {
		gap: 0.5rem 1rem;
	}

	.compact a {
		min-height: auto;
		font-size: 0.82rem;
	}
</style>
