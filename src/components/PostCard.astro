---
import { Image } from 'astro:assets';
import type { BlogPost } from '../utils/posts';
import { getReadingStats } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: BlogPost;
	compact?: boolean;
}

const { post, compact = false } = Astro.props;
const stats = getReadingStats(post.body ?? '');
const href = '/blog/' + post.id + '/';
const heroImage = post.data.heroImage;
---

<article class:list={['post-card surface', { 'post-card--compact': compact }]}>
	{
		heroImage && !compact && (
			<a class="post-card__media" href={href} aria-label={'阅读：' + post.data.title}>
				{typeof heroImage === 'string' ? (
					<img src={heroImage} alt="" width="960" height="480" loading="lazy" decoding="async" />
				) : (
					<Image src={heroImage} alt="" width={960} height={480} loading="lazy" />
				)}
			</a>
		)
	}
	<div class="post-card__body">
		<div class="post-card__meta">
			<a href={'/blog/categories/' + encodeURIComponent(post.data.category) + '/'}>
				{post.data.category}
			</a>
			<span aria-hidden="true">·</span>
			<FormattedDate date={post.data.pubDate} />
			<span aria-hidden="true">·</span>
			<span>{stats.minutes} 分钟</span>
			{post.data.draft && <span class="draft-badge">草稿</span>}
		</div>
		<h2><a href={href}>{post.data.title}</a></h2>
		<p>{post.data.description}</p>
		{
			post.data.tags.length > 0 && (
				<ul class="tag-list" aria-label="文章标签">
					{post.data.tags.map((tag) => (
						<li>
							<a class="tag" href={'/blog/tags/' + encodeURIComponent(tag) + '/'}>
								#{tag}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</article>

<style>
	.post-card {
		overflow: hidden;
	}

	.post-card__media {
		display: block;
		aspect-ratio: 2 / 1;
		overflow: hidden;
		background: var(--bg-secondary);
	}

	.post-card__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 350ms var(--ease);
	}

	.post-card:hover .post-card__media :global(img) {
		transform: scale(1.018);
	}

	.post-card__body {
		padding: 1.35rem;
	}

	.post-card__meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.42rem;
		margin-bottom: 0.7rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}

	.post-card__meta a {
		color: var(--accent);
	}

	.draft-badge {
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: var(--accent-surface);
		color: var(--accent);
		font-weight: 700;
	}

	h2 {
		margin-bottom: 0.55rem;
		font-size: clamp(1.22rem, 3vw, 1.48rem);
		line-height: 1.25;
	}

	h2 a {
		color: var(--text-primary);
	}

	h2 a:hover {
		color: var(--accent);
	}

	p {
		margin-bottom: 1rem;
		color: var(--text-secondary);
		font-size: 0.93rem;
		line-height: 1.65;
	}

	.post-card--compact {
		display: grid;
	}

	.post-card--compact .post-card__body {
		padding: 1.2rem;
	}

	.post-card--compact h2 {
		font-size: 1.18rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card__media :global(img) {
			transition: none;
		}
	}
</style>
