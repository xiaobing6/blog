---
import FormattedDate from '../../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../../consts';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getPublishedPosts } from '../../../utils/posts';

const posts = await getPublishedPosts();
const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))].sort(
	(a, b) => b - a,
);
---

<PageLayout title={'归档 | ' + SITE_TITLE} description="按发布时间浏览张迎明的全部技术文章。">
	<header class="archive-header">
		<p class="eyebrow">ARCHIVE / CHRONOLOGICAL</p>
		<h1>文章归档</h1>
		<p>{posts.length} 篇记录，按时间倒序排列。</p>
	</header>

	<div class="year-groups">
		{
			years.map((year) => (
				<section class="year-group" aria-labelledby={'year-' + year}>
					<h2 id={'year-' + year}>{year}</h2>
					<ul>
						{posts
							.filter((post) => post.data.pubDate.getFullYear() === year)
							.map((post) => (
								<li>
									<time>
										<FormattedDate date={post.data.pubDate} />
									</time>
									<a href={'/blog/' + post.id + '/'}>{post.data.title}</a>
									<span>{post.data.category}</span>
								</li>
							))}
					</ul>
				</section>
			))
		}
	</div>
</PageLayout>

<style>
	.archive-header {
		margin-bottom: 3rem;
	}

	.archive-header h1 {
		margin-bottom: 0.7rem;
	}

	.archive-header > p:last-child {
		color: var(--text-secondary);
	}

	.year-groups {
		display: grid;
		gap: 3rem;
	}

	.year-group {
		display: grid;
		grid-template-columns: 100px 1fr;
		gap: 1.5rem;
	}

	.year-group h2 {
		position: sticky;
		top: 80px;
		align-self: start;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 1rem;
	}

	.year-group ul {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--border);
	}

	.year-group li {
		display: grid;
		grid-template-columns: 118px 1fr auto;
		gap: 1rem;
		align-items: baseline;
		padding: 1rem 0;
		border-bottom: 1px solid var(--border);
	}

	.year-group time,
	.year-group li > span {
		color: var(--text-muted);
		font-size: 0.76rem;
	}

	.year-group a {
		color: var(--text-primary);
		font-weight: 650;
	}

	.year-group a:hover {
		color: var(--accent);
	}

	@media (max-width: 640px) {
		.year-group {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}

		.year-group h2 {
			position: static;
		}

		.year-group li {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
	}
</style>
