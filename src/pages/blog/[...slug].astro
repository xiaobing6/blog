---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import {
	getAdjacentPosts,
	getPublishedPosts,
	getReadingStats,
	getRelatedPosts,
} from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, posts },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	posts: CollectionEntry<'blog'>[];
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const stats = getReadingStats(post.body ?? '');
const adjacent = getAdjacentPosts(posts, post.id);
const related = getRelatedPosts(posts, post);
---

<BlogPost post={post} headings={headings} stats={stats} adjacent={adjacent} related={related}>
	<Content />
</BlogPost>
