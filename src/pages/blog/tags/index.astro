---
import { SITE_TITLE } from '../../../consts';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getPublishedPosts, getTags } from '../../../utils/posts';

const tags = getTags(await getPublishedPosts());
---

<PageLayout title={'标签 | ' + SITE_TITLE} description="按主题浏览张迎明的技术文章。">
	<header class="taxonomy-header">
		<p class="eyebrow">TOPICS / TAGS</p>
		<h1>标签</h1>
		<p>按具体技术或关注点查找文章。</p>
	</header>

	<ul class="taxonomy-grid">
		{
			tags.map((tag) => (
				<li>
					<a class="surface" href={'/blog/tags/' + encodeURIComponent(tag.name) + '/'}>
						<span>#{tag.name}</span>
						<strong>{tag.count}</strong>
					</a>
				</li>
			))
		}
	</ul>
</PageLayout>

<style>
	.taxonomy-header {
		margin-bottom: 2.5rem;
	}

	.taxonomy-header h1 {
		margin-bottom: 0.7rem;
	}

	.taxonomy-header > p:last-child {
		color: var(--text-secondary);
	}

	.taxonomy-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.taxonomy-grid a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 64px;
		padding: 0.9rem 1rem;
		color: var(--text-primary);
	}

	.taxonomy-grid a:hover {
		border-color: var(--accent);
	}

	.taxonomy-grid span {
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}

	.taxonomy-grid strong {
		color: var(--accent);
		font-size: 0.8rem;
	}
</style>
