---
import PostCard from '../../../components/PostCard.astro';
import { SITE_TITLE } from '../../../consts';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getCategories, getPublishedPosts } from '../../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return getCategories(posts).map(({ name }) => ({
		params: { category: name },
		props: { category: name, posts: posts.filter((post) => post.data.category === name) },
	}));
}

interface Props {
	category: string;
	posts: Awaited<ReturnType<typeof getPublishedPosts>>;
}

const { category, posts } = Astro.props;
---

<PageLayout
	title={'分类：' + category + ' | ' + SITE_TITLE}
	description={'“' + category + '”分类下的技术文章。'}
>
	<header class="taxonomy-header">
		<p class="eyebrow">CATEGORY</p>
		<h1>{category}</h1>
		<p>共 {posts.length} 篇文章</p>
	</header>

	<div class="post-list">
		{posts.map((post) => <PostCard post={post} compact />)}
	</div>

	<a class="back-link" href="/blog/categories/">← 返回全部分类</a>
</PageLayout>

<style>
	.taxonomy-header {
		margin-bottom: 2.5rem;
	}

	.taxonomy-header h1 {
		margin-bottom: 0.65rem;
	}

	.taxonomy-header > p:last-child {
		color: var(--text-secondary);
	}

	.post-list {
		display: grid;
		gap: 1rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		margin-top: 2rem;
		font-size: 0.88rem;
		font-weight: 650;
	}
</style>
