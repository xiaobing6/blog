---
import { SITE_TITLE } from '../../../consts';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getCategories, getPublishedPosts } from '../../../utils/posts';

const categories = getCategories(await getPublishedPosts());
---

<PageLayout title={'分类 | ' + SITE_TITLE} description="按内容领域浏览张迎明的技术文章。">
	<header class="taxonomy-header">
		<p class="eyebrow">SECTIONS / CATEGORIES</p>
		<h1>分类</h1>
		<p>从更完整的内容领域进入文章。</p>
	</header>

	<ul class="category-list">
		{
			categories.map((category, index) => (
				<li>
					<a class="surface" href={'/blog/categories/' + encodeURIComponent(category.name) + '/'}>
						<span class="index">{String(index + 1).padStart(2, '0')}</span>
						<strong>{category.name}</strong>
						<span class="count">{category.count} 篇</span>
					</a>
				</li>
			))
		}
	</ul>
</PageLayout>

<style>
	.taxonomy-header {
		margin-bottom: 2.5rem;
	}

	.taxonomy-header h1 {
		margin-bottom: 0.7rem;
	}

	.taxonomy-header > p:last-child {
		color: var(--text-secondary);
	}

	.category-list {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.category-list a {
		display: grid;
		grid-template-columns: 56px 1fr auto;
		align-items: center;
		min-height: 72px;
		padding: 0.8rem 1rem;
		color: var(--text-primary);
	}

	.category-list a:hover {
		border-color: var(--accent);
	}

	.index {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.7rem;
	}

	.count {
		color: var(--text-muted);
		font-size: 0.8rem;
	}
</style>
