---
import PostCard from '../../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import PageLayout from '../../layouts/PageLayout.astro';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
---

<PageLayout
	title={'文章 | ' + SITE_TITLE}
	description={SITE_DESCRIPTION}
	wide
	mainClass="blog-index"
>
	<header class="page-intro">
		<div>
			<p class="eyebrow">WRITING / NOTES & REVIEWS</p>
			<h1>技术记录</h1>
		</div>
		<p>记录 Web 开发、工程实践与持续学习中的判断、过程和复盘。</p>
	</header>

	<nav class="discovery surface" aria-label="文章浏览方式">
		<a href="/blog/tags/">标签 <span aria-hidden="true">#</span></a>
		<a href="/blog/categories/">分类 <span aria-hidden="true">⌘</span></a>
		<a href="/blog/archive/">归档 <span aria-hidden="true">↗</span></a>
		<a href="/search/">搜索 <span aria-hidden="true">⌕</span></a>
		<a href="/rss.xml">RSS <span aria-hidden="true">◌</span></a>
	</nav>

	<section aria-labelledby="all-posts-heading">
		<div class="section-header">
			<div>
				<p class="eyebrow">ALL POSTS</p>
				<h2 id="all-posts-heading">{posts.length} 篇记录</h2>
			</div>
			{import.meta.env.DEV && <span class="dev-note">开发环境包含草稿</span>}
		</div>
		{
			posts.length > 0 ? (
				<div class="post-list">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			) : (
				<div class="empty surface">
					<p>还没有公开文章。</p>
				</div>
			)
		}
	</section>
</PageLayout>

<style>
	.page-intro {
		display: grid;
		grid-template-columns: 1fr minmax(280px, 0.55fr);
		align-items: end;
		gap: 2rem;
		margin-bottom: 2.5rem;
	}

	.page-intro h1 {
		margin: 0;
	}

	.page-intro > p {
		margin: 0 0 0.6rem;
		color: var(--text-secondary);
	}

	.discovery {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		margin-bottom: 4rem;
		overflow: hidden;
	}

	.discovery a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 56px;
		padding: 0.8rem 1rem;
		border-right: 1px solid var(--border);
		color: var(--text-secondary);
		font-size: 0.85rem;
		font-weight: 650;
	}

	.discovery a:last-child {
		border-right: 0;
	}

	.discovery a:hover {
		background: var(--bg-secondary);
		color: var(--text-primary);
	}

	.discovery span {
		color: var(--accent);
		font-family: var(--font-mono);
	}

	.dev-note {
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: var(--accent-surface);
		color: var(--accent);
		font-size: 0.72rem;
	}

	.post-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
		gap: 1rem;
	}

	.empty {
		padding: 2rem;
		color: var(--text-secondary);
	}

	.empty p {
		margin: 0;
	}

	@media (max-width: 720px) {
		.page-intro {
			grid-template-columns: 1fr;
			gap: 0.6rem;
		}

		.discovery {
			grid-template-columns: repeat(2, 1fr);
		}

		.discovery a {
			border-bottom: 1px solid var(--border);
		}
	}
</style>
