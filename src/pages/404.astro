---
import { SITE_TITLE } from '../consts';
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
	title={'页面未找到 | ' + SITE_TITLE}
	description="请求的页面不存在。"
	noindex
	mainClass="not-found-page"
>
	<section class="not-found">
		<p class="code">ERROR / 404</p>
		<h1>这条路径没有内容。</h1>
		<p>链接可能已经变化，也可能还没有发布。你可以回到首页，或搜索现有文章。</p>
		<div>
			<a class="button button--primary" href="/">返回首页</a>
			<a class="button button--secondary" href="/search/">搜索文章</a>
		</div>
	</section>
</PageLayout>

<style>
	:global(.not-found-page) {
		display: grid;
		place-items: center;
	}

	.not-found {
		max-width: 620px;
		text-align: center;
	}

	.code {
		margin-bottom: 1rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
	}

	.not-found h1 {
		font-size: clamp(2.4rem, 8vw, 4.8rem);
	}

	.not-found > p:not(.code) {
		color: var(--text-secondary);
	}

	.not-found > div {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
</style>
