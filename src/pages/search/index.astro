---
import { SITE_TITLE } from '../../consts';
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout
	title={'搜索 | ' + SITE_TITLE}
	description="搜索本站公开的技术文章。"
	noindex
	mainClass="search-page"
>
	<div data-pagefind-ignore="all">
		<header class="search-header">
			<p class="eyebrow">SEARCH / PAGEFIND</p>
			<h1>搜索文章</h1>
			<p>搜索标题、摘要和正文内容。索引由静态构建生成，不会把查询发送到第三方服务。</p>
		</header>

		<form id="search-form" class="search-form surface" role="search">
			<label class="sr-only" for="search-input">搜索文章</label>
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<circle cx="11" cy="11" r="6.5"></circle>
				<path d="m16 16 4 4"></path>
			</svg>
			<input
				id="search-input"
				name="q"
				type="search"
				placeholder="输入关键词，例如 Astro"
				autocomplete="off"
				spellcheck="false"
			/>
			<button type="submit">搜索</button>
		</form>

		<p id="search-status" class="search-status" role="status" aria-live="polite">
			输入关键词开始搜索。
		</p>
		<ol id="search-results" class="search-results"></ol>
	</div>
</PageLayout>

<script type="module" is:inline>
	const form = document.querySelector('#search-form');
	const input = document.querySelector('#search-input');
	const status = document.querySelector('#search-status');
	const resultList = document.querySelector('#search-results');
	let pagefind;

	async function loadPagefind() {
		if (pagefind) return pagefind;
		pagefind = await import('/pagefind/pagefind.js');
		await pagefind.init();
		return pagefind;
	}

	function renderResult(data) {
		const item = document.createElement('li');
		item.className = 'search-result surface';

		const link = document.createElement('a');
		link.href = data.url;
		link.textContent = data.meta?.title ?? data.url;

		const excerpt = document.createElement('p');
		excerpt.innerHTML = data.excerpt ?? '打开页面查看匹配内容。';

		item.append(link, excerpt);
		return item;
	}

	async function search(query) {
		if (!status || !resultList) return;
		const normalizedQuery = query.trim();
		resultList.replaceChildren();

		if (!normalizedQuery) {
			status.textContent = '输入关键词开始搜索。';
			return;
		}

		status.textContent = '正在搜索…';

		try {
			const api = await loadPagefind();
			const response = await api.search(normalizedQuery);
			const results = await Promise.all(
				response.results.slice(0, 20).map((result) => result.data()),
			);
			results.forEach((result) => resultList.append(renderResult(result)));
			status.textContent =
				results.length > 0 ? '找到 ' + results.length + ' 条结果。' : '没有找到匹配内容。';
		} catch (error) {
			console.error('Pagefind search failed:', error);
			status.textContent = '搜索暂时不可用，请稍后再试。';
		}
	}

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		const query = input?.value ?? '';
		const url = new URL(window.location.href);
		if (query.trim()) url.searchParams.set('q', query.trim());
		else url.searchParams.delete('q');
		window.history.replaceState({}, '', url);
		void search(query);
	});

	const initialQuery = new URLSearchParams(window.location.search).get('q') ?? '';
	if (input && initialQuery) {
		input.value = initialQuery;
		void search(initialQuery);
	}
</script>

<style>
	.search-header {
		margin-bottom: 2rem;
	}

	.search-header h1 {
		margin-bottom: 0.7rem;
	}

	.search-header > p:last-child {
		max-width: 640px;
		color: var(--text-secondary);
	}

	.search-form {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		padding: 0.45rem;
	}

	.search-form svg {
		width: 20px;
		height: 20px;
		margin-left: 0.75rem;
		fill: none;
		stroke: var(--text-muted);
		stroke-width: 1.8;
		stroke-linecap: round;
	}

	.search-form input {
		width: 100%;
		min-height: 48px;
		padding: 0 0.8rem;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--text-primary);
	}

	.search-form button {
		min-height: 44px;
		padding: 0.55rem 1rem;
		border: 0;
		border-radius: 999px;
		background: var(--accent);
		color: white;
		cursor: pointer;
		font-weight: 650;
	}

	.search-status {
		margin: 1rem 0;
		color: var(--text-muted);
		font-size: 0.82rem;
	}

	.search-results {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	:global(.search-result) {
		padding: 1rem 1.1rem;
	}

	:global(.search-result a) {
		color: var(--text-primary);
		font-size: 1.05rem;
		font-weight: 650;
	}

	:global(.search-result p) {
		margin: 0.4rem 0 0;
		color: var(--text-secondary);
		font-size: 0.88rem;
	}

	:global(.search-result mark) {
		border-radius: 3px;
		background: var(--accent-surface);
		color: var(--accent);
	}
</style>
