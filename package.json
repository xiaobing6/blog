{
	"name": "my-astro-blog",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev --background",
		"build": "astro build && pagefind --site dist",
		"dev:stop": "astro dev stop",
		"dev:status": "astro dev status",
		"dev:logs": "astro dev logs",
		"build:astro": "astro build",
		"check": "astro check",
		"format": "prettier --write \"src/**/*.{astro,ts,js,md,mdx,css}\" \"docs/*.md\" package.json prettier.config.mjs",
		"format:check": "prettier --check \"src/**/*.{astro,ts,js,md,mdx,css}\" \"docs/*.md\" package.json prettier.config.mjs",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/mdx": "^7.0.3",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.1.3",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.3.3"
	},
	"overrides": {
		"fast-xml-parser": "^5.10.1",
		"js-yaml": "^4.3.0",
		"postcss": "^8.5.23",
		"svgo": "^4.0.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^6.0.3"
	}
}
